# Оркестратор + deployer (docker-compose.pipeline.yml). Каталог: корневой .env
PORT=3020
POLL_INTERVAL_MS=30000
GITHUB_TOKEN=
GITHUB_REPO=AlexeyAbretov/llm_app_dev
CURSOR_API_KEY=
CURSOR_REPO_URL=https://github.com/AlexeyAbretov/llm_app_dev
CURSOR_STARTING_REF=main
CURSOR_MODEL=composer-2.5
DATA_DIR=/data
PROMPTS_DIR=/app/prompts
# deployer: stub (по умолчанию) | compose (docker compose каталога, mongo)
DEPLOY_MODE=stub
