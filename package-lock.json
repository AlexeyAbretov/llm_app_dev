{
  "name": "llm-app-dev",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "llm-app-dev",
      "workspaces": [
        "frontend",
        "backend",
        "shared"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "backend": {
      "name": "@llm-app/backend",
      "version": "0.0.1",
      "dependencies": {
        "@llm-app/shared": "*"
      }
    },
    "frontend": {
      "name": "@llm-app/frontend",
      "version": "0.0.1",
      "dependencies": {
        "@llm-app/shared": "*"
      }
    },
    "node_modules/@llm-app/backend": {
      "resolved": "backend",
      "link": true
    },
    "node_modules/@llm-app/frontend": {
      "resolved": "frontend",
      "link": true
    },
    "node_modules/@llm-app/shared": {
      "resolved": "shared",
      "link": true
    },
    "shared": {
      "name": "@llm-app/shared",
      "version": "0.0.1"
    }
  }
}
