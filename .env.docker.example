# Переменные для docker compose --profile app (см. docker-compose.yml).
# Ollama — на хосте, не в контейнере; backend обращается через host.docker.internal.

MONGO_URI=mongodb://mongo:27017/catalog
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TRANSLATE_MODEL=qwen2.5:0.5b
PORT=3001
